{
  "listen": ":7865",
  "api_key": "change-me",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "models_file": "./data/models.json",
  "cooldown": {
    "soft_rate": "60s",
    "err_threshold": 5,
    "err_cooldown": "10m"
  },
  "schedule": {
    "keepalive_hours": [4]
  },
  "upstream": {
    "response_header_timeout_seconds": 30,
    "timeout_seconds": 120
  }
}
